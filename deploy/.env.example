# Copy to .env beside docker-compose.yml. Never commit the copy.
# Generate each key as described in backend/.env.example.
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
BLIND_INDEX_KEY=
FIELD_ENCRYPTION_KEYS=

DATABASE_URL=postgres://onboarding_app:CHANGE@DB_HOST:5432/member_onboarding
MIGRATION_DATABASE_URL=postgres://onboarding_owner:CHANGE@DB_HOST:5432/member_onboarding

REDIS_URL=redis://redis:6379/0
DJANGO_ALLOWED_HOSTS=onboarding.example.com,backend,localhost
NUM_PROXIES=1
PORTAL_URL=https://onboarding.example.com
EXPOSE_API_DOCS=false

# Inside the containers. MEDIA_PATH below is where it lives on the server.
MEDIA_ROOT=/var/lib/member-onboarding/media
MEDIA_PATH=/var/lib/member-onboarding/media
TLS_PATH=/etc/member-onboarding/tls
NEXT_PUBLIC_DEFAULT_ORGANIZATION=kashee
