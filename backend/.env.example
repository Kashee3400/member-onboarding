# Only secrets and deployment values live here. Mail, SMS, storage and other
# third-party connections are managed per organization from the admin.

DJANGO_SETTINGS_MODULE=config.settings.local

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=

# Comma-separated key_id:base64-32-byte-key pairs. The first key encrypts; all keys decrypt.
# Generate: python -c "import base64, secrets; print('k1:' + base64.b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEYS=

# Where uploaded files live. Must be outside the code. Back this folder up.
# Linux server: /var/lib/member-onboarding/media
MEDIA_ROOT=K:\member-onboarding-media

# Runtime role. Must not be a superuser and must not have BYPASSRLS.
# Keeps Aadhaar and bank duplicate checks private. Changing it breaks those checks.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
BLIND_INDEX_KEY=

DATABASE_URL=postgres://onboarding_app:change-me@127.0.0.1:5432/member_onboarding
# Owner role, used only by `manage.py migrate`.
MIGRATION_DATABASE_URL=postgres://onboarding_owner:change-me@127.0.0.1:5432/member_onboarding

# Leave empty to use in-process cache locally. Required in production.
REDIS_URL=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Proxies in front of this service. The admin portal counts as one.
NUM_PROXIES=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
EXPOSE_API_DOCS=true
# The portal's public address, used in emailed links.
PORTAL_URL=http://localhost:3000
